# Copy to .env.local. Everything is optional for the local demo.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated phone numbers that get the store dashboard (demo default: 9999999999)
ADMIN_PHONES=9999999999
# Where the local JSON database lives (default ./.data, or /tmp/turant on serverless)
# DATA_DIR=.data
# Set when a real SMS provider is wired in lib/auth.ts; hides the on-screen demo code
# SMS_PROVIDER=msg91
